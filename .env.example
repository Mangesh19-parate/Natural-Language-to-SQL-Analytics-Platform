# Environment mode: local, test, staging, production
ENVIRONMENT=local
DEBUG=True

# Metadata Database (PostgreSQL)
METADATA_DB_URL=postgresql://postgres:postgres@localhost:5432/sql_assistant_metadata
# Metadata SQLite fallback for local unit test isolation
METADATA_SQLITE_URL=sqlite:///./local_data/metadata.db

# Business Execution Database (PostgreSQL - primary with readonly user)
BUSINESS_DB_URL=postgresql://readonly_app_user:readonly_pass@localhost:5432/sql_assistant_business
BUSINESS_ADMIN_DB_URL=postgresql://postgres:postgres@localhost:5432/sql_assistant_business
# Business SQLite fallback for local test isolation
BUSINESS_SQLITE_URL=sqlite:///./local_data/business.db

# Security & Authentication
JWT_SECRET_KEY=dev-insecure-secret-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Configuration
LLM_PROVIDER=mock  # 'openai' | 'groq' | 'gemini' | 'mock'
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEFAULT_MODEL_NAME=gpt-4o-mini
DEFAULT_TEMPERATURE=0.0

# Execution Sandbox Limits (Rule R1.5)
QUERY_TIMEOUT_SECONDS=10
QUERY_ROW_LIMIT=10000
